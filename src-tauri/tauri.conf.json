{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fast-comment",
  "version": "0.2.0",
  "identifier": "dev.skyfade.fastcomment",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "fast-comment",
        "width": 460,
        "height": 820,
        "minWidth": 320,
        "minHeight": 400,
        "resizable": true,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis-hooks.nsh"
      }
    },
    "resources": {
      "../templates": "templates"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2NEQyOUZGNzgwMTY1MzIKUldReVpRRjQveWxORmc2MExqU28zVUFXQlk4azBVcUE2SXhjUXB2YS90cnU3OHJ3alRRMDkwYVQK",
      "endpoints": [
        "https://github.com/machaniconico/fast-comment/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
